// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Outdial Call Component Address Book functionality displays address book entries 1`] = `
<div>
  <article
    class="outdial-container"
    data-testid="outdial-call-container"
  >
    <mdc-tablist
      active-tab-id="address_book"
      class="tab-list"
    >
      <mdc-tab
        active=""
        aria-controls="address_book"
        aria-selected="true"
        ariastatekey="aria-selected"
        role="tab"
        tab-id="address_book"
        tabindex="0"
        text="Address Book"
        variant="glass"
      />
      <mdc-tab
        aria-controls="dial_pad"
        aria-selected="false"
        ariastatekey="aria-selected"
        role="tab"
        tab-id="dial_pad"
        tabindex="-1"
        text="Dialpad"
        variant="glass"
      />
    </mdc-tablist>
    <section
      aria-labelledby="address_book"
      class="address-book-container"
      id="address_book"
      role="tabpanel"
    >
      <section
        class="address-book"
        data-testid="outdial-address-book-container"
      >
        <mdc-input
          class="address-book-search-input"
          data-testid="outdial-address-book-search-input"
          help-text-type="default"
          name="outdial-address-book-search-input"
          value=""
        />
        <ul
          class="address-book-entries"
        >
          <li
            aria-label="Select John Doe"
            class="address-book-entry "
            role="button"
            tabindex="0"
          >
            <mdc-avatar
              size="32"
            />
            <div>
              <p>
                John Doe
              </p>
              <p>
                +14691234567
              </p>
            </div>
          </li>
          <li
            aria-label="Select Jane Smith"
            class="address-book-entry "
            role="button"
            tabindex="0"
          >
            <mdc-avatar
              size="32"
            />
            <div>
              <p>
                Jane Smith
              </p>
              <p>
                +14699876543
              </p>
            </div>
          </li>
        </ul>
      </section>
    </section>
    <div
      class="outdial-ani-select-container"
    >
      <mdc-select
        class="outdial-input"
        data-testid="outdial-ani-option-select"
        help-text-type="default"
        label="Outdial ANI"
        name="outdial-ani-option-select"
        value=""
      >
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-none"
          label="Enter Outdial ANI"
          tabindex="0"
          value="none"
          variant="inset-rectangle"
        >
          Enter Outdial ANI
        </mdc-option>
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-1"
          label="name 1"
          tabindex="0"
          value="1"
          variant="inset-rectangle"
        >
          name 1
        </mdc-option>
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-2"
          label="name 2"
          tabindex="0"
          value="2"
          variant="inset-rectangle"
        >
          name 2
        </mdc-option>
      </mdc-select>
    </div>
    <mdc-button
      aria-disabled="true"
      color="default"
      data-btn-type="icon"
      data-testid="outdial-call-button"
      disabled=""
      prefix-icon="handset-regular"
      role="button"
      size="40"
      tabindex="-1"
      type="button"
      variant="primary"
    />
  </article>
</div>
`;

