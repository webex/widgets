      </li>
    </ul>
    <div
      class="outdial-ani-select-container"
    >
      <mdc-select
        class="outdial-input"
        data-testid="outdial-ani-option-select"
        help-text-type="default"
        label="Outdial ANI"
        name="outdial-ani-option-select"
        value=""
      >
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-none"
          label="Enter Outdial ANI"
          tabindex="0"
          value="none"
          variant="inset-rectangle"
        >
          Enter Outdial ANI
        </mdc-option>
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-1"
          label="name 1"
          tabindex="0"
          value="1"
          variant="inset-rectangle"
        >
          name 1
        </mdc-option>
        <mdc-option
          aria-disabled="false"
          aria-selected="false"
          data-testid="outdial-ani-option-2"
          label="name 2"
          tabindex="0"
          value="2"
          variant="inset-rectangle"
        >
          name 2
        </mdc-option>
      </mdc-select>
    </div>
    <mdc-button
      aria-disabled="true"
      color="default"
      data-btn-type="icon"
      data-testid="outdial-call-button"
      disabled=""
      prefix-icon="handset-regular"
      role="button"
      size="40"
      tabindex="-1"
      type="button"
      variant="primary"
    />
  </article>
</div>
`;
